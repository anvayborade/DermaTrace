        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/ic_dermatrace_mark" android:contentDescription="DermaTrace icon"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="DermaTrace" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="32sp" android:id="@+id/txtSplashBrand"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="AI-assisted skin lesion tracking" android:textColor="@color/dt_text_muted" android:textSize="13sp"/>
    </LinearLayout>
</FrameLayout>
