<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarLesionDetail" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/dt_surface" app:title="Lesion details" app:titleTextColor="@color/dt_text" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"/>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_glass_card">
    <TextView android:id="@+id/txtLesionBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Body location" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/>
    <TextView android:id="@+id/txtLesionNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="No lesion notes" android:textColor="@color/dt_text_muted" android:textSize="11sp"/>
    <TextView android:id="@+id/txtLatestAssessment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="No assessment yet — take the first scan." android:textColor="@color/dt_text_muted" android:textSize="11sp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="2"><com.google.android.material.button.MaterialButton android:id="@+id/btnFollowUpScan" style="@style/Widget.DermaTrace.Button.Primary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="New scan" android:textSize="11sp" app:icon="@drawable/ic_camera_alt" app:iconTint="@color/dt_white"/><com.google.android.material.button.MaterialButton android:id="@+id/btnCompareLatest" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Compare" android:textSize="11sp" app:icon="@drawable/ic_compare" app:iconTint="@color/dt_text_muted"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="2"><com.google.android.material.button.MaterialButton android:id="@+id/btnLesionReports" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Reports" android:textSize="11sp" app:icon="@drawable/ic_description" app:iconTint="@color/dt_primary"/><com.google.android.material.button.MaterialButton android:id="@+id/btnSetReminder" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Reminder" android:textSize="11sp" app:icon="@drawable/ic_notifications" app:iconTint="@color/dt_primary"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="2"><com.google.android.material.button.MaterialButton android:id="@+id/btnEditLesion" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Edit lesion" android:textSize="11sp" app:icon="@drawable/ic_edit" app:iconTint="@color/dt_text_muted"/><com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteLesion" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Delete lesion" android:textColor="@color/dt_danger" android:textSize="11sp" app:icon="@drawable/ic_delete" app:iconTint="@color/dt_danger" app:strokeColor="@color/dt_danger"/></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Recent scans" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="15sp"/>
   <TextView android:id="@+id/txtTimelineEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="18dp" android:gravity="center" android:background="@drawable/bg_info_banner" android:text="No scans saved for this lesion yet." android:textColor="@color/dt_text_muted" android:textSize="11sp"/>
   <ListView android:id="@+id/listLesionTimeline" android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="4dp" android:divider="@null" android:dividerHeight="0dp" android:nestedScrollingEnabled="true"/>
 </LinearLayout></ScrollView>
</LinearLayout>
