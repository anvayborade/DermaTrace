<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/loginRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_app_gradient" android:clipToPadding="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="700dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="24dp" android:paddingTop="28dp" android:paddingEnd="24dp" android:paddingBottom="24dp">

        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_dermatrace_mark" android:contentDescription="DermaTrace"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="DermaTrace" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="30sp" android:id="@+id/txtLoginBrand"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="AI-assisted skin analysis\nfor earlier, healthier tomorrows." android:textColor="@color/dt_text_muted" android:textSize="12sp" android:gravity="center" android:lineSpacingExtra="2dp"/>

        <LinearLayout android:layout_width="160dp" android:layout_height="100dp" android:layout_marginTop="16dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_info_banner">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_dermatrace_mark" android:alpha="0.8" android:contentDescription="Medical skin analysis"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:hint="Email address" app:boxBackgroundMode="filled" app:boxBackgroundColor="@color/dt_surface_soft" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="1dp" app:boxStrokeColor="@color/dt_primary" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@drawable/ic_email" app:startIconTint="@color/dt_text_muted">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLoginEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:singleLine="true" android:textColor="@color/dt_text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Password" app:boxBackgroundMode="filled" app:boxBackgroundColor="@color/dt_surface_soft" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="1dp" app:boxStrokeColor="@color/dt_primary" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@drawable/ic_lock" app:startIconTint="@color/dt_text_muted" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLoginPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/dt_text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:id="@+id/txtForgotPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="Forgot password?" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="12sp" android:clickable="true" android:focusable="true"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnEmailLogin" style="@style/Widget.DermaTrace.Button.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:text="Sign in  →"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/dt_divider"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="or continue with" android:textColor="@color/dt_text_muted" android:textSize="11sp"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/dt_divider"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnGoogleLogin" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Sign in with Google" app:icon="@drawable/ic_google_g" app:iconTint="@null" app:iconGravity="textStart" app:iconPadding="12dp" app:iconSize="20dp"/>

        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressLogin" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="12dp" android:visibility="gone" app:indicatorColor="@color/dt_primary" app:trackColor="@color/dt_primary_container"/>
        <TextView android:id="@+id/txtLoginStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/dt_text_muted" android:textSize="11sp" android:gravity="center"/>
        <TextView android:id="@+id/txtCreateAccount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="6dp" android:text="Don’t have an account?  Create one" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="12sp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</ScrollView>
