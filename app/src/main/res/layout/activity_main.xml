<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/dt_surface" app:title="DermaTrace" app:titleTextColor="@color/dt_text" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="20dp">

            <TextView android:id="@+id/txtGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Good morning, Anvay" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="25sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Here’s your recent activity." android:textColor="@color/dt_text_muted" android:textSize="13sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="92dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_glass_card" android:padding="14dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center_vertical" android:src="@drawable/ic_description" app:tint="@color/dt_primary" android:background="@drawable/bg_chip_primary" android:padding="9dp" android:contentDescription="Scans"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="center_vertical">
                    <TextView android:id="@+id/txtDashboardTotalScans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total scans" android:textColor="@color/dt_text" android:textSize="12sp"/>
                    <TextView android:id="@+id/txtDashboardMonthScans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="+0 this month" android:textColor="@color/dt_primary" android:textSize="10sp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="@color/dt_divider"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/txtDashboardPatientCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Patients" android:textColor="@color/dt_text" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active cases" android:textColor="@color/dt_text_muted" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Latest scans" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all  →" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="11sp" android:id="@+id/btnSeeAllScans" android:clickable="true" android:focusable="true" android:padding="8dp" android:contentDescription="See all scans in history"/>
            </LinearLayout>

            <TextView android:id="@+id/txtLatestEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="18dp" android:gravity="center" android:background="@drawable/bg_info_banner" android:text="Your recent scans will appear here." android:textColor="@color/dt_text_muted" android:textSize="12sp"/>
            <HorizontalScrollView android:id="@+id/latestScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" android:scrollbars="none"><LinearLayout android:id="@+id/latestContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingEnd="16dp"/></HorizontalScrollView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Quick actions" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="16sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="3">
                <LinearLayout android:id="@+id/cardNewAnalysis" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="86dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass_tile" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_camera_alt" app:tint="@color/dt_primary" android:contentDescription="New analysis"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="New analysis" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
                <LinearLayout android:id="@+id/cardPatients" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="86dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass_tile" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_people" app:tint="@color/dt_accent_b" android:contentDescription="Patients"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Patients" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
                <LinearLayout android:id="@+id/cardHistory" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="86dp" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass_tile" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_history" app:tint="@color/dt_accent_b" android:contentDescription="History"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="History" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="3">
                <LinearLayout android:id="@+id/cardReports" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="86dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass_tile" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_description" app:tint="@color/dt_primary" android:contentDescription="Reports"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Reports" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
                <LinearLayout android:id="@+id/cardFollowUps" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="86dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass_tile" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_notifications" app:tint="@color/dt_accent_b" android:contentDescription="Follow-ups"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Follow-ups" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
                <LinearLayout android:id="@+id/cardCompare" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="86dp" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass_tile" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_compare" app:tint="@color/dt_primary" android:contentDescription="Compare"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Compare" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
            </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_info_banner" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_description" app:tint="@color/dt_primary" android:contentDescription="Privacy information"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your analysis, saved locally" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="12sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="View your scan history, reports and follow-ups even when offline. This research prototype is not a diagnosis." android:textColor="@color/dt_text_muted" android:textSize="11sp" android:lineSpacingExtra="2dp"/></LinearLayout></LinearLayout></LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
