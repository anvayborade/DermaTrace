<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.DermaTrace.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/dt_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="TextAppearance.DermaTrace.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/dt_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">25sp</item>
    </style>
    <style name="TextAppearance.DermaTrace.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/dt_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="TextAppearance.DermaTrace.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/dt_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.DermaTrace.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/dt_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.DermaTrace.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/dt_primary</item>
        <item name="android:textColor">@color/dt_white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.DermaTrace.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/dt_surface</item>
        <item name="android:textColor">@color/dt_text</item>
        <item name="strokeColor">@color/dt_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.DermaTrace.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/dt_primary_container</item>
        <item name="android:textColor">@color/dt_primary_dark</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
