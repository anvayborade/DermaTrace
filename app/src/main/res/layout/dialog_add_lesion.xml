<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <EditText android:id="@+id/edtDialogLesionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Lesion label e.g. Left forearm mole"/>
    <Spinner android:id="@+id/spinnerDialogBodyLocation" android:layout_width="match_parent" android:layout_height="48dp"/>
    <EditText android:id="@+id/edtDialogLesionNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Notes (optional)"/>
</LinearLayout>
