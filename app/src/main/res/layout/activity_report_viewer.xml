<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReportViewer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dt_surface"
        app:title="Analysis report"
        app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"
        app:titleTextColor="@color/dt_text" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReportShareTxt" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Share TXT" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReportSharePdf" style="@style/Widget.DermaTrace.Button.Primary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Share PDF" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReportSaveTxt" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Save TXT" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReportSavePdf" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Save PDF" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/bg_glass_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_dermatrace_mark" android:contentDescription="DermaTrace" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DermaTrace" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="18sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Skin lesion assessment report" android:textColor="@color/dt_text_muted" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView android:id="@+id/imgReportViewer" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="16dp" android:scaleType="centerCrop" android:background="@drawable/bg_image_rounded" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="Assessment image" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/dt_divider" />
                <TextView android:id="@+id/txtReportContents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/dt_text" android:textSize="13sp" android:lineSpacingExtra="4dp" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
