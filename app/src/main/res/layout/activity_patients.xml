<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarPatients" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/dt_surface" app:title="Patients" app:titleTextColor="@color/dt_text" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"><com.google.android.material.button.MaterialButton android:id="@+id/btnAddPatient" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="end" android:text="" app:icon="@drawable/ic_people" app:iconTint="@color/dt_primary" app:iconSize="22dp"/></com.google.android.material.appbar.MaterialToolbar>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp">
  <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search patients by name or details" app:boxBackgroundMode="filled" app:boxBackgroundColor="@color/dt_surface_soft" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxCornerRadiusTopStart="20dp" app:boxCornerRadiusTopEnd="20dp" app:boxCornerRadiusBottomStart="20dp" app:boxCornerRadiusBottomEnd="20dp" app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/dt_text_muted"><com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPatientSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/dt_text"/></com.google.android.material.textfield.TextInputLayout>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="All" android:textColor="@color/dt_white" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/bg_chip_selected" android:id="@+id/chipPatientsAll" android:clickable="true" android:focusable="true"/><TextView android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Active" android:textColor="@color/dt_text_muted" android:textSize="12sp" android:background="@drawable/bg_chip_outline" android:id="@+id/chipPatientsActive" android:clickable="true" android:focusable="true"/><TextView android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Follow-up" android:textColor="@color/dt_text_muted" android:textSize="12sp" android:background="@drawable/bg_chip_outline" android:id="@+id/chipPatientsFollowup" android:clickable="true" android:focusable="true"/><TextView android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="No recent scans" android:textColor="@color/dt_text_muted" android:textSize="12sp" android:background="@drawable/bg_chip_outline" android:id="@+id/chipPatientsNoScans" android:clickable="true" android:focusable="true"/></LinearLayout></HorizontalScrollView>
 </LinearLayout>
 <TextView android:id="@+id/txtPatientsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:padding="22dp" android:gravity="center" android:background="@drawable/bg_info_banner" android:text="No patients yet. Add a patient to begin tracking lesions." android:textColor="@color/dt_text_muted" android:textSize="12sp"/>
 <ListView android:id="@+id/listPatients" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="2dp" android:paddingBottom="16dp" android:clipToPadding="false" android:divider="@null" android:dividerHeight="0dp"/>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
 <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
