<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">

  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarResult" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/dt_surface" app:title="Analysis result" app:titleTextColor="@color/dt_text" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>

  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="18dp">

      <TextView android:id="@+id/txtResultStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASSESSMENT SAVED" android:textColor="@color/dt_text_muted" android:textStyle="bold" android:textSize="10sp" android:visibility="gone"/>
      <TextView android:id="@+id/txtResultContext" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dt_text_muted" android:textSize="10sp" android:visibility="gone"/>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top|center_vertical" android:minHeight="124dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/imgResult" android:layout_width="118dp" android:layout_height="118dp" android:scaleType="centerCrop" android:background="@drawable/bg_image_rounded" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="Lesion image"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
          <TextView android:id="@+id/txtTriage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_high" android:text="Higher model concern" android:textColor="@color/dt_danger" android:textStyle="bold" android:textSize="12sp" android:maxLines="2" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"/>
          <TextView android:id="@+id/txtSimpleExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="The AI found visual features that warrant professional assessment." android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="13sp" android:lineSpacingExtra="2dp" android:maxLines="6"/>
          <TextView android:id="@+id/txtClinicalMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/dt_text_muted" android:textSize="14sp" android:lineSpacingExtra="2dp"/>
        </LinearLayout>
      </LinearLayout>

      <!-- tab row -->
      <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"><TextView android:id="@+id/tabResultOverview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Overview" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true"/><View android:id="@+id/indicatorOverview" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/dt_primary"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"><TextView android:id="@+id/tabResultAi" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="AI Analysis" android:textColor="@color/dt_text_muted" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true"/><View android:id="@+id/indicatorAi" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/dt_primary" android:visibility="invisible"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"><TextView android:id="@+id/tabResultQuality" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Quality" android:textColor="@color/dt_text_muted" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true"/><View android:id="@+id/indicatorQuality" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/dt_primary" android:visibility="invisible"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"><TextView android:id="@+id/tabResultSimilar" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Similar" android:textColor="@color/dt_text_muted" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true"/><View android:id="@+id/indicatorSimilar" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/dt_primary" android:visibility="invisible"/></LinearLayout>
      </LinearLayout>

      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>

      <!-- OVERVIEW -->
      <LinearLayout android:id="@+id/resultPanelOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/cardTop3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/bg_glass_card">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Top 3 visual resemblances" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/>
          <TextView android:id="@+id/txtTop3" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:text="1" android:textStyle="bold" android:textColor="@color/dt_primary" android:background="@drawable/bg_chip_primary"/><TextView android:id="@+id/txtTop1Friendly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="@color/dt_text" android:textSize="13sp"/><ProgressBar android:id="@+id/progressTop1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="68dp" android:layout_height="5dp" android:max="1000" android:progressTint="@color/dt_accent_c" android:progressBackgroundTint="@color/dt_divider"/><TextView android:id="@+id/txtTop1Percent" android:layout_width="46dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/dt_text" android:textSize="12sp"/></LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:text="2" android:textStyle="bold" android:textColor="@color/dt_accent_b" android:background="@drawable/bg_glass_tile"/><TextView android:id="@+id/txtTop2Friendly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="@color/dt_text" android:textSize="13sp"/><ProgressBar android:id="@+id/progressTop2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="68dp" android:layout_height="5dp" android:max="1000" android:progressTint="@color/dt_accent_c" android:progressBackgroundTint="@color/dt_divider"/><TextView android:id="@+id/txtTop2Percent" android:layout_width="46dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/dt_text" android:textSize="12sp"/></LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:text="3" android:textStyle="bold" android:textColor="@color/dt_text_muted" android:background="@drawable/bg_glass_tile"/><TextView android:id="@+id/txtTop3Friendly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="@color/dt_text" android:textSize="13sp"/><ProgressBar android:id="@+id/progressTop3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="68dp" android:layout_height="5dp" android:max="1000" android:progressTint="@color/dt_accent_c" android:progressBackgroundTint="@color/dt_divider"/><TextView android:id="@+id/txtTop3Percent" android:layout_width="46dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/dt_text" android:textSize="12sp"/></LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_glass_card">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plain language explanation" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="The concern result summarizes the specialised image models. It is not a diagnosis, and a lower-concern result does not rule out skin cancer." android:textColor="@color/dt_text_muted" android:textSize="12sp" android:lineSpacingExtra="2dp" android:id="@+id/txtOverviewPlainLanguage"/>
          <TextView android:id="@+id/txtAssessmentNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No personal note added." android:textColor="@color/dt_text_muted" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardAiOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_info_banner" android:padding="14dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦  AI overview" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/>
          <TextView android:id="@+id/txtAiOverviewStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/dt_text_muted" android:textSize="11sp"/>
          <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressAiOverview" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:visibility="gone" app:indicatorColor="@color/dt_primary"/>
          <TextView android:id="@+id/txtAiOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/dt_text_muted" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btnGenerateOverview" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:text="Generate AI overview" android:textAllCaps="false" android:textColor="@color/dt_primary" android:textSize="10sp"/>
        </LinearLayout>
      </LinearLayout>

      <!-- AI ANALYSIS -->
      <LinearLayout android:id="@+id/resultPanelAiAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_glass_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="How the model assessed this image" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="15sp"/><TextView android:id="@+id/txtAiAnalysisSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/dt_text_muted" android:textSize="12sp" android:lineSpacingExtra="3dp"/></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/btnTechnical" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="View technical details" android:textSize="11sp"/>
        <LinearLayout android:id="@+id/panelTechnical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_info_banner" android:visibility="gone"><TextView android:id="@+id/txtTechnicalDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dt_text_muted" android:textSize="10sp" android:lineSpacingExtra="2dp"/></LinearLayout>
      </LinearLayout>

      <!-- QUALITY -->
      <LinearLayout android:id="@+id/resultPanelQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_glass_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Image quality" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/><TextView android:id="@+id/txtQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/dt_text_muted" android:textSize="11sp"/></LinearLayout>
        <LinearLayout android:id="@+id/cardSegmentation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_glass_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lesion localization" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/><TextView android:id="@+id/txtSegmentation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/dt_text_muted" android:textSize="11sp"/></LinearLayout>
      </LinearLayout>

      <!-- SIMILAR -->
      <LinearLayout android:id="@+id/resultPanelSimilar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_glass_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About visual similarity" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="The detailed classifier compares the image with learned visual patterns. These resemblance labels are secondary information and should not be interpreted as a diagnosis." android:textColor="@color/dt_text_muted" android:textSize="11sp" android:lineSpacingExtra="2dp"/></LinearLayout>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/dt_surface" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:id="@+id/rowResultActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveResult" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Note" android:textSize="12sp" app:icon="@drawable/ic_edit" app:iconTint="@color/dt_text_muted" app:iconSize="18dp" android:maxLines="1" android:minWidth="0dp" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" app:iconPadding="4dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnShareResult" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="Share" android:textSize="12sp" app:icon="@drawable/ic_compare" app:iconTint="@color/dt_text_muted" app:iconSize="18dp" android:maxLines="1" android:minWidth="0dp" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" app:iconPadding="4dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnPdfResult" style="@style/Widget.DermaTrace.Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="PDF" android:textSize="12sp" app:icon="@drawable/ic_description" app:iconTint="@color/dt_white" app:iconSize="18dp" android:maxLines="1" android:minWidth="0dp" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" app:iconPadding="4dp" android:contentDescription="Generate PDF report"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="3.4">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnNewAnalysis" style="@style/Widget.DermaTrace.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1.4" android:layout_marginEnd="4dp" android:text="New analysis" android:textSize="12sp" app:icon="@drawable/ic_camera_alt" app:iconTint="@color/dt_primary_dark" app:iconSize="18dp" android:maxLines="1" android:minWidth="0dp" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" app:iconPadding="4dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnHome" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="Home" android:textSize="12sp" app:icon="@drawable/ic_dashboard" app:iconTint="@color/dt_text_muted" app:iconSize="18dp" android:maxLines="1" android:minWidth="0dp" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" app:iconPadding="4dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnResultActions" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="More" android:textSize="12sp" app:icon="@drawable/ic_more_vert" app:iconTint="@color/dt_text_muted" app:iconSize="18dp" android:maxLines="1" android:minWidth="0dp" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" app:iconPadding="4dp" android:contentDescription="More actions"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
