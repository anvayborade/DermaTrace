<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarComparison" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/dt_surface" app:title="Compare scans" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"
        app:titleTextColor="@color/dt_text" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Previous vs current" style="@style/TextAppearance.DermaTrace.Title" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                    <ImageView android:id="@+id/imgComparisonOld" android:layout_width="match_parent" android:layout_height="170dp" android:scaleType="centerCrop" android:background="@drawable/bg_image_rounded" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="Previous lesion scan" />
                    <TextView android:id="@+id/txtComparisonOldDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/dt_text_muted" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                    <ImageView android:id="@+id/imgComparisonNew" android:layout_width="match_parent" android:layout_height="170dp" android:scaleType="centerCrop" android:background="@drawable/bg_image_rounded" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="Current lesion scan" />
                    <TextView android:id="@+id/txtComparisonNewDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/dt_text_muted" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/bg_glass_card">
                <TextView android:id="@+id/txtComparisonConcern" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="16sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/dt_divider" />
                <TextView android:id="@+id/txtComparisonArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/dt_text_muted" android:textSize="13sp" />
                <TextView android:id="@+id/txtComparisonPattern" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/dt_text_muted" android:textSize="13sp" />
            </LinearLayout>

            <TextView android:id="@+id/txtComparisonNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_info_banner" android:textColor="@color/dt_text" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="This is a visual/AI comparison only. It is not a calibrated measurement of lesion growth or clinical progression." android:textColor="@color/dt_text_muted" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
