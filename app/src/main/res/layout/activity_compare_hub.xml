<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarCompareHub" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/dt_surface" app:title="Compare scans" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"
        app:titleTextColor="@color/dt_text" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Longitudinal comparison" style="@style/TextAppearance.DermaTrace.Headline" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Only lesions with at least two saved scans appear here." style="@style/TextAppearance.DermaTrace.Secondary" />
    </LinearLayout>
    <TextView android:id="@+id/txtCompareEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:padding="24dp" android:gravity="center" android:background="@drawable/bg_glass_card" android:text="No comparable lesions yet. Save at least two scans for the same lesion." android:textColor="@color/dt_text_muted" android:textSize="14sp" />
    <ListView android:id="@+id/listComparableLesions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="24dp" android:clipToPadding="false" android:divider="@null" android:dividerHeight="0dp" />
</LinearLayout>
