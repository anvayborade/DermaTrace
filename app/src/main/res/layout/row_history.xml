<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="4dp" android:paddingEnd="16dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/bg_glass_row">
        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/rowImage" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop" android:background="@drawable/bg_image_rounded" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="Assessment image"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/rowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/rowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/dt_text_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/rowConcern" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:background="@drawable/bg_chip_primary" android:textColor="@color/dt_primary_dark" android:textStyle="bold" android:textSize="9sp"/>
            <TextView android:id="@+id/rowPattern" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/dt_text_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:layout_width="18dp" android:layout_height="wrap_content" android:text="›" android:textColor="@color/dt_text_muted" android:textSize="22sp" android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
