<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_app_gradient">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarNewAnalysis" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/dt_surface" app:title="New analysis" app:titleTextColor="@color/dt_text" app:titleTextAppearance="@style/TextAppearance.DermaTrace.ToolbarTitle"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Patient" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="16sp"/><TextView android:id="@+id/btnAddNewPatientInline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="＋ Add new patient" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="11sp" android:clickable="true" android:focusable="true"/></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:background="@drawable/bg_glass_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select patient / profile" android:textSize="11sp" android:textColor="@color/dt_text_muted"/><Spinner android:id="@+id/spinnerPatientProfile" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown" android:contentDescription="Select an existing patient profile"/></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Lesion information" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="16sp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Lesion label (optional)" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/dt_surface" app:boxStrokeColor="@color/dt_border" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@drawable/ic_description" app:startIconTint="@color/dt_text_muted"><com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLesionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/dt_text" android:gravity="center_vertical|start" android:minHeight="52dp" android:paddingTop="0dp" android:paddingBottom="0dp"/></com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="5dp" android:paddingEnd="12dp" android:paddingBottom="5dp" android:background="@drawable/bg_glass_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Body location" android:textColor="@color/dt_text_muted" android:textSize="10sp"/><Spinner android:id="@+id/spinnerBodyLocation" android:layout_width="match_parent" android:layout_height="42dp" android:spinnerMode="dropdown" android:backgroundTint="@color/dt_text_muted"/></LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Notes (optional)" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/dt_surface" app:boxStrokeColor="@color/dt_border" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLesionNotes" android:layout_width="match_parent" android:layout_height="82dp" android:gravity="top|start" android:inputType="textMultiLine" android:maxLines="4" android:maxLength="500" android:textColor="@color/dt_text"/></com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Add image" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="16sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="2"><com.google.android.material.button.MaterialButton android:id="@+id/btnStartNewAnalysis" style="@style/Widget.DermaTrace.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Take photo" android:textSize="12sp" app:strokeColor="@color/dt_primary" app:strokeWidth="2dp" app:icon="@drawable/ic_camera_alt" app:iconTint="@color/dt_primary_dark" app:iconGravity="textStart"/><com.google.android.material.button.MaterialButton android:id="@+id/btnChooseExistingImage" style="@style/Widget.DermaTrace.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Choose image" android:textSize="12sp" app:icon="@drawable/ic_file_open" app:iconTint="@color/dt_text_muted" app:iconGravity="textStart"/></LinearLayout>
        <LinearLayout android:id="@+id/cardSelectedImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/bg_info_banner" android:visibility="gone">
          <ImageView android:id="@+id/imgSelectedThumb" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:background="@drawable/bg_image_rounded" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="Preview of the selected image"/>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/txtSelectedFileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="middle" android:textColor="@color/dt_text" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/txtSelectedFileMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/dt_success" android:textSize="12sp"/>
          </LinearLayout>
          <TextView android:id="@+id/btnClearSelectedImage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="6dp" android:text="Remove" android:textColor="@color/dt_primary" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <TextView android:id="@+id/txtSelectedImageStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Camera selected • tap Continue to open capture" android:textColor="@color/dt_text_muted" android:textSize="10sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="ⓘ  Use a well-lit photo with the area in focus." android:textColor="@color/dt_text_muted" android:textSize="10sp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnContinueAnalysis" style="@style/Widget.DermaTrace.Button.Primary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Continue  →"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnUseExistingLesion" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="Open an existing lesion for a follow-up scan" android:textAllCaps="false" android:textColor="@color/dt_primary" android:textSize="11sp"/>
      </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dt_divider"/>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
